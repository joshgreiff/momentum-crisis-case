# Copy to .env.local for local development. In Vercel, set these under Project → Settings → Environment Variables.

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Shared with the team. At least 8 characters; 12+ recommended.
TEAM_PASSCODE=
# Random, at least 32 characters, never shared. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Optional ---
OPENAI_MODEL=gpt-4.1-mini
MAX_UPDATES_PER_HOUR=10
MAX_UPDATES_PER_DAY=40
MAX_ATTEMPTS_PER_UPDATE=3
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
